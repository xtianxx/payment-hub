    {
      "datasource": "Prometheus",
      "description": "契约查询：sum(rate(payment_hub_http_requests_total[$__rate_interval])) or vector(0)。应用停止时以抓取状态 up=0 区分，不能只看速率。",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0,
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [],
