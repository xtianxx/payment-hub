        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "(sum(rate(payment_hub_http_requests_total{status=~\"5..\"}[$__rate_interval])) or vector(0)) / (sum(rate(payment_hub_http_requests_total[$__rate_interval])) > 0)",
          "instant": false,
          "legendFormat": "5xx 比例",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "HTTP 5xx 比例",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "滚动窗口 P95，按路由拆分；使用 $__rate_interval，与契约查询文档中的 1 分钟窗口口径对应。",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
