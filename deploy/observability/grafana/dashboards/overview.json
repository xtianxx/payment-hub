          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(rate(payment_hub_http_requests_total[$__rate_interval])) or vector(0)",
          "instant": false,
          "legendFormat": "请求速率",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "HTTP 请求速率",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
