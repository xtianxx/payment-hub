        "x": 0,
        "y": 9
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(payment_hub_http_request_duration_seconds_bucket[$__rate_interval])))",
          "instant": false,
          "legendFormat": "{{route}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "滚动 P95 延迟（按路由）",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "整轮 P95 在所选时间范围结束时刻以 instant 查询显示；使用 $__range 对直方图桶做 increase，用于与 k6 P95 对照；差异容差为 ±3ms 或 ±20%（取较大者）。",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, route) (increase(payment_hub_http_request_duration_seconds_bucket[$__range])))",
          "instant": true,
          "legendFormat": "{{route}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "整轮 P95 延迟（按路由）",
      "type": "stat"
    },
